Options -MultiViews
RewriteEngine On

# 1. Редирект з www на non-www + HTTPS
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 2. Редирект з HTTP на HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. Примусовий редирект: якщо користувач ввів .html, видаляємо його з URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4. Видаляємо кінцевий слеш (щоб /contact/ перенаправляло на /contact)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 5. Внутрішнє перенаправлення: сервер непомітно відкриває .html файл
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# 6. Закриття від індексації для певних ботів
# RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|yandex|baiduspider) [NC]
# RewriteRule .* - [F,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php80” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
